{
  "inputs": {
    "counts": "Datesets/asv-counts.csv",
    "taxonomy": "Datesets/taxa.csv",
    "metadata": "Datesets/metadata.csv",
    "tree": "Datesets/tree.nexus"
  },
  "filters": {
    "min_library_size": 500,
    "rarefaction_depths": [
      500,
      1000
    ],
    "min_feature_prevalence": 3,
    "min_feature_total_count": 10,
    "max_retained_features": null,
    "beta_top_taxa": 100,
    "keep_kingdom": [
      "Bacteria"
    ],
    "exclude_order": [
      "Chloroplast"
    ],
    "exclude_family": [
      "Mitochondria"
    ],
    "exclude_phyla": [
      "Cyanobacteria",
      "Cyanobacteriota"
    ]
  },
  "analysis": {
    "primary_group": "Developmental_Stage",
    "secondary_groups": [
      "study_alias",
      "Scientific_Name",
      "Geography",
      "Timepoint"
    ],
    "permutations": 99,
    "threads": 4,
    "io_threads": 2,
    "max_samples": 120,
    "beta_rank": "Genus",
    "pcoa_axes": 2
  },
  "differential_abundance": {
    "groups": [
      "Seeds",
      "Seedlings"
    ],
    "min_prevalence": 0.1
  },
  "taxonomy_analysis": {
    "core_prevalence_threshold": 0.5,
    "core_abundance_threshold": 0.001,
    "indicator_permutations": 99,
    "strip_other_threshold": 0.03
  },
  "memory": {
    "enabled": true,
    "use_mori": false,
    "share_inputs": false,
    "cache_beta_distances": true,
    "mirai_workers": 1,
    "mirai_memory_mb": null
  },
  "outputs": {
    "directory": "analysis_results_smoke",
    "write_distance_matrices": false
  }
}
