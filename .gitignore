tmp_debug*/
_quarantine/
~$*
* (1).*

# ── Large inputs: never committable to GitHub (100 MB/file limit) ───────────
# Datesets/ holds 2.6 GB of read-only source data (asv-counts.csv 609 MB,
# feature-table.tsv 1.3 GB). It stays on disk; provenance is recorded by
# convert_seedling_tables.py and the study accessions in the metadata.
Datesets/
*.qza
*.biom
feature-table.tsv

# ── Regenerable outputs ────────────────────────────────────────────────────
# Figures and rendered reports are rebuilt by one render of the master document.
analysis_results/figures/
analysis_results/cache/
analysis_results/objects/
analysis_results/setup/
analysis_results/diversity/
analysis_results/validation/*_aligned.csv
analysis_results/validation/*.npz
analysis_results_smoke/
*.html

# Kept in version control (small, or not reproducible):
#   analysis_results/tables/       result tables, figure legends and captions
#   analysis_results/manuscript/   manuscript documents of record
#   analysis_results/validation/   audit tables, figures and memo
#   analysis_results/differential_abundance/
#   tasks/plans/                   plans and the archived pre-merge sources

# Downloaded reference data (Greengenes, BugBase, FAPROTAX ...); fetched, never committed
resources/

# ── Added 2026-10-28 ───────────────────────────────────────────────────────
# PICRUSt2 intermediates (alignments up to 62 MB); rebuilt by ko_predict.sh
analysis_results/picrust2/intermediate/
# local copies of manuscript versions and scratch renders
tasks/backups/
tasks/tmp_view/
Rplots*.pdf
