for r1 in *_1.clean.fastq.gz
do
  base=${r1%_1.clean.fastq.gz}
  fastp \
    -i ${base}_1.clean.fastq.gz \
    -I ${base}_2.clean.fastq.gz \
    --merge \
    --merged_out ${base}.merged.fastq.gz \
    --unpaired1 ${base}.unmerged_R1.fastq.gz \
    --unpaired2 ${base}.unmerged_R2.fastq.gz \
    --overlap_len_require 20 \
    --html ${base}.fastp.html \
    --json ${base}.fastp.json
done
